/**
 * A library of functions for displaying graphics on the screen.
 * The Hack physical screen consists of 256 rows (indexed 0..255, top to bottom)
 * of 512 pixels each (indexed 0..511, left to right). The top left pixel on 
 * the screen is indexed (0,0).
 */
class Screen {
    static boolean color;  // true: black, false: white
    static Array two_to_the_i;
    static Array screen;

        /** Initializes the Screen. */
        function void init() {
            var int i;
            var int value;
            let color = true;
            let screen = 16384;  // address of screen
            
            let two_to_the_i = Array.new(16);
            let value = 1;
            let i = 0;

            while (i < 16) 
            {
                let two_to_the_i[i] = value;
                let value = ^value;
                let i = i + 1;
            }
            return;
        }

        /** Erases the entire screen. */
        function void clearScreen() {
            var int i;
            let i = 0;

            // 256 rows * 32 ints = 8192 ints
            if (color) // color is black so screen is white
            {
                while (i < 8192) 
                {
                    let screen[i] = 0; 
                    let i = i + 1;
                } 
            }
            else // color is white so screen is black
            {
                while (i < 8192) 
                {
                    let screen[i] = -1;
                    let i = i + 1;
                }
            }

            return;
        }

        /** Sets the current color, to be used for all subsequent drawXXX commands.
         *    Black is represented by true, white by false. */
        function void setColor(boolean b) {
            let color = b;
            return;
        }

        /** Draws the (x,y) pixel, using the current color. */
        function void drawPixel(int x, int y) {
            // For this function, you will need to calculate the value x%16.
            // It should be calculated quickly without using multiplication or
            // division, using exactly one basic math/logical operation.
            // In addition, calculating 16384 + y * 32 + x/16 should not use
            // division or multiplication.
            // Pseudocode:
            // 1. Compute the RAM address where the (x,y) pixel is
            //    represented: 16384 + (32*y) + (x/16).
            // 2. Use Memory.peek to get the 16-bit value of this address
            // 3. Use some bitwise operation to set (only) the bit that corresponds
            //    to the pixel to the current color.
            // 4. Use Memory.poke to write the modified 16-bit value to the RAM
            // address.
            var int address_on_screen;
            var int peek_value;
            var int x_mod_16;

            if ((x < 0) | (x > 511) | (y < 0) | (y > 255)) 
            {
                do Sys.error(7);
            }
            
            // address_on_screen = (y*32) + (x/16)
            let address_on_screen = (^(^(^(^(^y))))) + (#(#(#(#x))));
            let peek_value = screen[address_on_screen];
            
            let x_mod_16 = x & 15;          // x % 16
            
            if (color) 
            {
                // set bit to 1 
                let peek_value = peek_value | two_to_the_i[x_mod_16];
            } 
            else 
            {
                // set bit to 0 
                let peek_value = peek_value & (~two_to_the_i[x_mod_16]);
            }

            let screen[address_on_screen] = peek_value;
            return;
        }

        function void draw_horizontal_line(int y, int x_start, int x_end) {
            var int start_addr;
            var int end_addr;
            var int cur_addr;
            var int start_offset;
            var int end_offset;
            var int cur_offset;
            var int peek_value;

            let start_addr = (^(^(^(^(^y))))) + (#(#(#(#x_start))));
            let end_addr = (^(^(^(^(^y))))) + (#(#(#(#x_end))));
            let start_offset = x_start & 15;
            let end_offset = x_end & 15;

            if (start_addr = end_addr) 
            {
                let peek_value = screen[start_addr];
                let cur_offset = start_offset;
                while (~(cur_offset > end_offset)) 
                {
                    if (color) 
                    {
                        let peek_value = peek_value | two_to_the_i[cur_offset];
                    } 
                    else 
                    {
                        let peek_value = peek_value & (~two_to_the_i[cur_offset]);
                    }
                    let cur_offset = cur_offset + 1;
                }
                let screen[start_addr] = peek_value;
                return;
            } 
            else 
            {
                // first partial int
                let peek_value = screen[start_addr];
                let cur_offset = start_offset;
                while (cur_offset < 16) 
                {
                    if (color) 
                    {
                        let peek_value = peek_value | two_to_the_i[cur_offset];
                    } 
                    else 
                    {
                        let peek_value = peek_value & (~two_to_the_i[cur_offset]);
                    }
                    let cur_offset = cur_offset + 1;
                }
                let screen[start_addr] = peek_value;

                // middle full ints
                let cur_addr = start_addr + 1;
                while (cur_addr < end_addr) 
                {
                    if (color) 
                    {
                        let screen[cur_addr] = -1;
                    } 
                    else 
                    {
                        let screen[cur_addr] = 0;
                    }
                    let cur_addr = cur_addr + 1;
                }

                // last partial int
                let peek_value = screen[end_addr];
                let cur_offset = 0;
                while (~(cur_offset > end_offset)) 
                {
                    if (color) 
                    {
                        let peek_value = peek_value | two_to_the_i[cur_offset];
                    } 
                    else 
                    {
                        let peek_value = peek_value & (~two_to_the_i[cur_offset]);
                    }
                    let cur_offset = cur_offset + 1;
                }
                let screen[end_addr] = peek_value;
                return;
            }
        }

        function void draw_vertical_line(int x, int y_start, int y_end) {
            var int current_y;
            let current_y = y_start;

            while (~(current_y > y_end)) 
            {
                do Screen.drawPixel(x, current_y);
                let current_y = current_y + 1;
            }
            return;
        }

        function void draw_general_line(int x1, int y1, int x2, int y2) {
            var int dx;
            var int dy;
            var int a;
            var int b;
            var int diff;

            let dx = x2 - x1;
            let dy = y2 - y1;
            let a = 0;
            let b = 0;
            let diff = 0;

            if (dy > 0) // line goes down
            {
                while ((~(a > dx)) & (~(b > dy))) 
                {
                    do Screen.drawPixel(x1 + a, y1 + b);
                    
                    if (diff < 0) 
                    {
                        let a = a + 1;
                        let diff = diff + dy;
                    } 
                    else 
                    {
                        let b = b + 1;
                        let diff = diff - dx;
                    }
                }
                return;
            } 
            else // line goes up
            {
                let dy = -dy;

                while ((~(a > dx)) & (~(b > dy))) 
                {
                    do Screen.drawPixel(x1 + a, y1 - b);
                    
                    if (diff < 0) 
                    {
                        let a = a + 1;
                        let diff = diff + dy;
                    } 
                    else 
                    {
                        let b = b + 1;
                        let diff = diff - dx;
                    }
                }
                return;
            }
        }

        /** Draws a line from pixel (x1,y1) to pixel (x2,y2), using the current color. */
        function void drawLine(int x1, int y1, int x2, int y2) {
            // The case where x1 != x2 and y1 != y2 should be implemented without
            // multiplication or division.
            // Pseudocode:
            // 1. let x = x1, y = y1, a = 0, b = 0, diff = 0
            // 2. Compute dx and dy
            // 3. while ((a <= dx) and (b <= dy))
            // 4.   do drawPixel(x+a, y+b)
            // 5.   if (diff < 0) { let a=a+1, diff=diff+dy }
            // 6.   else          { let b=b+1, diff=diff-dx }
            //
            // The case where y1 == y2 can be implemented efficiently by
            // trying to draw as many pixels as possible in a single assignment,
            // similarly to Fill in project 4.

            if ((x1 < 0) | (x1 > 511) | (y1 < 0) | (y1 > 255) | 
                (x2 < 0) | (x2 > 511) | (y2 < 0) | (y2 > 255)) 
            {
                do Sys.error(8);
            }

            // horizontal line
            if (y1 = y2) 
            {
                if (x1 > x2) 
                {
                    do Screen.draw_horizontal_line(y1, x2, x1);
                } 
                else 
                {
                    do Screen.draw_horizontal_line(y1, x1, x2);
                }
                return;
            }
            // vertical line
            if (x1 = x2) 
            {
                if (y1 > y2) 
                {
                    do Screen.draw_vertical_line(x1, y2, y1);
                } 
                else 
                {
                    do Screen.draw_vertical_line(x1, y1, y2);
                }
                return;
            }

            // general case
            // force line going left to right
            if (x2 > x1) 
            {
                do Screen.draw_general_line(x1, y1, x2, y2);
            } 
            else 
            {
                do Screen.draw_general_line(x2, y2, x1, y1);
            }

            return;
        }

        /** Draws a filled rectangle whose top left corner is (x1, y1)
         * and bottom right corner is (x2,y2), using the current color. */
        function void drawRectangle(int x1, int y1, int x2, int y2) {
            
            var int current_y;

            if ((x1 < 0) | (x1 > 511) | (y1 < 0) | (y1 > 255) | 
                (x2 < 0) | (x2 > 511) | (y2 < 0) | (y2 > 255) | 
                (x2 < x1) | (y2 < y1)) 
            {
                do Sys.error(9);
            }

            let current_y = y1;

            while (~(current_y > y2)) 
            {
                do Screen.draw_horizontal_line(current_y, x1, x2);
                let current_y = current_y + 1;
            }
            return;
        }

        /** Draws a filled circle of radius r<=181 around (x,y), using the current color. */
        function void drawCircle(int x, int y, int r) {
            // This can be implemented efficiently by drawing multiple lines at
            // each iteration. You can use multiplication and sqrt.
            // Pseudocode:
            // 1. for (dy = -r ... r)
            // 2.   let halfWidth = sqrt(r*r - dy*dy)
            // 3.   do drawLine(x-halfWidth, y+dy, x+halfWidth, y+dy)
            var int dy;
            var int half_width;
            var int r_squared;

            if ((x < 0) | (x > 511) | (y < 0) | (y > 255)) 
            {
                do Sys.error(12);
            }
            if ((r < 1) | (r > 181)) 
            {
                do Sys.error(13);
            }

            let dy = -r;
            let r_squared = r * r;
            while (~(dy > r)) 
            {
                let half_width = Math.sqrt(r_squared - (dy * dy));  // pythagorean theorem
                
                // draw line at this y level
                do Screen.draw_horizontal_line(y + dy, x - half_width, x + half_width);
                
                let dy = dy + 1;
            }
            return;
        }
}
